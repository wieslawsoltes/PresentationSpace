<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(PresentationTargetFrameworks)' != ''">$(PresentationTargetFrameworks)</TargetFrameworks>
    <UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer</UnoFeatures>
    <OutputType>Library</OutputType><GenerateLibraryLayout>true</GenerateLibraryLayout>
    <Description>Reusable slide viewport, filmstrip, inspector, notes, sorter and presenter controls for Uno Platform.</Description><IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PresentationSpace.Core/PresentationSpace.Core.csproj" />
    <ProjectReference Include="../PresentationSpace.Rendering.Skia/PresentationSpace.Rendering.Skia.csproj" />
    <ProjectReference Include="../PresentationSpace.Ribbon.Uno/PresentationSpace.Ribbon.Uno.csproj" />
    <PackageReference Include="Uno.WinUI.Graphics2DSK" Version="6.7.135" />
  </ItemGroup>
</Project>
